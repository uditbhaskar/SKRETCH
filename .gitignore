# =============================================================================
# SKRETCH — Android / Kotlin / Gradle / Jetpack Compose
# Machine-specific, generated, and secret files stay out of version control.
# =============================================================================

# --- Gradle ---
.gradle/
**/.gradle/
**/build/
build/
.gradle-home/
gradle-app.setting
!gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# Local Gradle overrides (SDK paths, signing, secrets)
gradle.properties.local
local.properties
*.local

# --- Android Studio / IntelliJ IDEA ---
*.iml
*.ipr
*.iws
.idea/
.idea_modules/
out/

# Android Studio captures & device screenshots
captures/

# --- Kotlin ---
.kotlin/
*.class

# --- Android / NDK ---
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
output.json
*.hprof
bin/
gen/

# R8 / ProGuard outputs (generated on release builds)
**/mapping.txt
**/seeds.txt
**/usage.txt
**/configuration.txt

# --- Signing & secrets (never commit) ---
*.jks
*.keystore
keystore.properties
signing.properties
secrets.properties
google-services.json
GoogleService-Info.plist
.env
.env.*
!.env.example

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Logs & temp ---
*.log
*.tmp
*.temp
*.swp
*.swo
*~
*.orig
*.rej

# --- Test & coverage reports ---
**/reports/
**/test-results/
**/androidTest-results/
.jacoco/
*.exec
coverage/
htmlReport/

# --- Fastlane (if added later) ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# --- Editor / tooling (not part of the app) ---
.cursor/
.navigation/
.fleet/

# --- Android Lint intermediates ---
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# --- Misc ---
*.salive
dependency-graph/
